@startuml After
title After: separated modules
component "main.tsx" as Main
component "App.tsx\n(UI, form state, feedback)" as App
component "rooms.ts\n(Room type, ROOMS, EQUIPMENT)" as rooms
component "filter.ts\n(filterRooms: F1, F2)" as filter
component "booking.ts\n(canBook AC1-AC5, checkRoom F3, F5)" as booking
